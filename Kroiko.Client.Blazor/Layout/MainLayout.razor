@inherits LayoutComponentBase
@inject IDialogService DialogService

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <a href="" class="d-flex align-center mr-4">
            <img src="Assets/kroiko.png" alt="Kroiko" height="40" />
        </a>
        @* Text links from sm up; icon-only on phones, where the labels do not fit. *@
        <MudButton Href="" Color="Color.Inherit" Class="d-none d-sm-flex"
                   StartIcon="@Icons.Material.Filled.ReceiptLong">Converter</MudButton>
        <MudButton Href="configuration" Color="Color.Inherit" Class="d-none d-sm-flex"
                   StartIcon="@Icons.Material.Filled.Settings">Configuration</MudButton>
        <MudIconButton Href="" Color="Color.Inherit" Class="d-flex d-sm-none"
                       Icon="@Icons.Material.Filled.ReceiptLong" aria-label="Converter" />
        <MudIconButton Href="configuration" Color="Color.Inherit" Class="d-flex d-sm-none"
                       Icon="@Icons.Material.Filled.Settings" aria-label="Configuration" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Inherit"
                       aria-label="Относно" OnClick="OpenAboutAsync" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private Task OpenAboutAsync() =>
        DialogService.ShowAsync<AboutDialog>("Относно", new DialogOptions { CloseButton = true });
}
