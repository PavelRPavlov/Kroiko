@inherits LayoutComponentBase
@implements IDisposable
@using Kroiko.Client.Blazor.Updates
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppUpdates AppUpdates
@inject UpdateOffer UpdateOffer

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <a href="" class="d-flex align-center mr-4">
            <img src="Assets/kroiko.png" alt="Kroiko" height="40" />
        </a>
        @* Text links from sm up; icon-only on phones, where the labels do not fit. *@
        @foreach (var link in NavLinks)
        {
            <MudButton Href="@link.Href" Color="Color.Inherit" Class="d-none d-sm-flex"
                       StartIcon="@link.Icon">@link.Label</MudButton>
            <MudIconButton Href="@link.Href" Color="Color.Inherit" Class="d-flex d-sm-none"
                           Icon="@link.Icon" aria-label="@link.Label" />
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Inherit"
                       aria-label="Относно" OnClick="OpenAboutAsync" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private sealed record NavLinkItem(string Href, string Icon, string Label);

    private static readonly NavLinkItem[] NavLinks =
    [
        new("./", Icons.Material.Filled.ReceiptLong, "Converter"), // not "": MudBlazor renders an empty Href as a <button>
        new("configuration", Icons.Material.Filled.Settings, "Configuration"),
    ];

    // The reload snackbar while UpdateOffer.ShowsSnackbar; null while none is shown.
    private Snackbar? _updateSnackbar;

    protected override void OnInitialized()
    {
        UpdateOffer.Changed += OnUpdateOfferChanged;
        UpdateOffer.Error += OnUpdateOfferError;
    }

    // The layout lives as long as the app: from its first render on, the app hears about new versions (ADR-0002 §1).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await AppUpdates.StartAsync();
    }

    public void Dispose()
    {
        UpdateOffer.Changed -= OnUpdateOfferChanged;
        UpdateOffer.Error -= OnUpdateOfferError;
    }

    // The offer also changes from a JS callback, so through InvokeAsync; event handlers, hence async void.
    private async void OnUpdateOfferChanged() => await InvokeAsync(ShowOrHideUpdateSnackbar);

    private async void OnUpdateOfferError(string message) =>
        await InvokeAsync(() => Snackbar.Add(message, Severity.Error));

    // A persistent snackbar (ADR-0002 §1) until "По-късно": no timeout, no close icon; its buttons are its only actions.
    private void ShowOrHideUpdateSnackbar()
    {
        if (UpdateOffer.ShowsSnackbar && _updateSnackbar is null)
        {
            _updateSnackbar = Snackbar.Add<UpdateSnackbar>(severity: Severity.Info, configure: options =>
            {
                options.RequireInteraction = true;
                options.ShowCloseIcon = false;
            });
        }
        else if (!UpdateOffer.ShowsSnackbar && _updateSnackbar is not null)
        {
            Snackbar.Remove(_updateSnackbar);
            _updateSnackbar = null;
        }
    }

    private Task OpenAboutAsync() =>
        DialogService.ShowAsync<AboutDialog>("Относно", new DialogOptions { CloseButton = true });
}
