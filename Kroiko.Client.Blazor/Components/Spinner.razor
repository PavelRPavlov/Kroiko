@* The Server's shared indeterminate spinner, copied as is (ADR-0005 §1). *@

<MudStack AlignItems="AlignItems.Center" Class="pa-3">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    <MudText Typo="Typo.subtitle2">@Label</MudText>
</MudStack>

@code {
    [Parameter] public string Label { get; set; } = "Working";
}
