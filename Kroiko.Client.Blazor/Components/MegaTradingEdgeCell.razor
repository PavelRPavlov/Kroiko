@using Kroiko.Domain.TemplateBuilding

@* One banded side in the MegaTrading grid (ADR-0015): the width and the thickness, each picked from exactly the values
   MegaTrading's software lists. A side with an edge whose value is missing shows it in red; "—" in both is no edge. *@
<div class="d-flex gap-1 megatrading-edge" data-side="@Side">
    <MudSelect T="string" Value="@_edge?.Width" ValueChanged="SetWidthAsync" Dense="true" Margin="Margin.Dense"
               Error="@(_edge is { HasWidth: false })" Class="edge-width" aria-label="@($"{Side}: ширина")" Style="min-width: 4.5rem">
        <MudSelectItem Value="@string.Empty">—</MudSelectItem>
        @foreach (var width in MegaTradingEdge.Widths)
        {
            <MudSelectItem Value="@width">@width</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string" Value="@_edge?.Thickness" ValueChanged="SetThicknessAsync" Dense="true" Margin="Margin.Dense"
               Error="@(_edge is { HasThickness: false })" Class="edge-thickness" aria-label="@($"{Side}: дебелина")" Style="min-width: 5.5rem">
        <MudSelectItem Value="@string.Empty">—</MudSelectItem>
        @foreach (var thickness in MegaTradingEdge.Thicknesses)
        {
            <MudSelectItem Value="@thickness">@thickness</MudSelectItem>
        }
    </MudSelect>
</div>

@code {
    /// <summary>The side's <c>.cut_mt</c> cell, e.g. <c>22/0.5</c>; empty when the side has no edge.</summary>
    [Parameter, EditorRequired] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The side's Bulgarian name, for the pickers' accessible names.</summary>
    [Parameter, EditorRequired] public string Side { get; set; } = default!;

    private MegaTradingEdge? _edge;

    protected override void OnParametersSet() => _edge = MegaTradingEdge.Parse(Value);

    private Task SetWidthAsync(string? width) => SetAsync(width ?? string.Empty, _edge?.Thickness ?? string.Empty);

    private Task SetThicknessAsync(string? thickness) => SetAsync(_edge?.Width ?? string.Empty, thickness ?? string.Empty);

    // Both parts empty is no edge; otherwise the cell is {width}/{thickness}, a part still to pick left empty.
    private Task SetAsync(string width, string thickness)
    {
        var edge = new MegaTradingEdge(width, thickness);
        return ValueChanged.InvokeAsync(edge == new MegaTradingEdge(string.Empty, string.Empty) ? string.Empty : edge.ToString());
    }
}
