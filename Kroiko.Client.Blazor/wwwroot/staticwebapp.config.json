{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/css/*",
      "/js/*",
      "/fonts/*",
      "*.{js,css,wasm,dat,json,webmanifest,png,ico,woff2}"
    ]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/service-worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/service-worker-assets.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".dat": "application/octet-stream",
    ".wasm": "application/wasm",
    ".woff2": "font/woff2"
  }
}
