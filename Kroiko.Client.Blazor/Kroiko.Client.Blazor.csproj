<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The hand-maintained SemVer, bumped in the PR that goes to release; 1.0.0 at go-live. The SDK appends +<sha>,
         and About shows it as vX.Y.Z (sha) (ADR-0002 §5–6). scripts/publish-pwa.ps1 reads it as X.Y.Z. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Keep ICU globalization: do not set InvariantGlobalization. MudBlazor's number and date display
         follows the operator's culture; the domain stays invariant on its own (ADR-0004). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The conversion runs in the browser on the shared, browser-safe domain (ADR-0004). -->
    <ProjectReference Include="..\Kroiko.Domain\Kroiko.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach internals, e.g. the device-settings store with other schema migrations. -->
    <InternalsVisibleTo Include="Kroiko.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
