<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Kroiko.Domain.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Kroiko.Domain\Kroiko.Domain.csproj" />
    </ItemGroup>

    <!-- Shared test data (ADR-0007 §2): copied to the output of every project that references this one. -->
    <ItemGroup>
      <None Update="TestData\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
