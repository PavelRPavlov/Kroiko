<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The compiler guards browser safety (ADR-0004 §7): the domain runs trimmed in WASM, so reflection
             the trimmer cannot see, untyped JSON and the file system fail the build. No suppressions: if one
             of these fires, something browser-unsafe got in. -->
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL2070;IL2075;IL3050;RS0030</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="LargeXlsx" Version="2.0.2" />
      <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <!-- The banned-API list (RS0030, an error above): APIs that have no meaning in the browser. -->
      <AdditionalFiles Include="BannedSymbols.txt" />
    </ItemGroup>

    <ItemGroup>
      <!-- The builders, row providers and generators are internal behind IOrderFormat (ADR-0004 §1); the
           domain's own tests still pin them one by one. -->
      <InternalsVisibleTo Include="Kroiko.Domain.Tests" />
    </ItemGroup>

    <ItemGroup>
      <!-- Compiled into the DLL (ADR-0004 §2): no file on disk, so they work in the browser and are
           offline-cached with the assembly. Manifest names: Kroiko.Domain.TemplateBuilding.<Manufacturer>.template.json -->
      <None Remove="TemplateBuilding\*\template.json" />
      <EmbeddedResource Include="TemplateBuilding\*\template.json" />
    </ItemGroup>

</Project>
