<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="LargeXlsx" Version="1.12.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- Compiled into the DLL (ADR-0004 §2): no file on disk, so they work in the browser and are
           offline-cached with the assembly. Manifest names: Kroiko.Domain.TemplateBuilding.<Manufacturer>.template.json -->
      <None Remove="TemplateBuilding\*\template.json" />
      <EmbeddedResource Include="TemplateBuilding\*\template.json" />
    </ItemGroup>

</Project>
