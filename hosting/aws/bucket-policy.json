{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheTwoDistributionsReadTheReleases",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::<bucket>", "arn:aws:s3:::<bucket>/*"],
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": [
            "arn:aws:cloudfront::<account-id>:distribution/<main-distribution-id>",
            "arn:aws:cloudfront::<account-id>:distribution/<production-distribution-id>"
          ]
        }
      }
    }
  ]
}
