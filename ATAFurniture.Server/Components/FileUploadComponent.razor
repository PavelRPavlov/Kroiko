@using Kroiko.Domain.CellsExtracting
@using System.IO
@using ATAFurniture.Server.Models
@using System.Collections.ObjectModel
@using ATAFurniture.Server.DataAccess
@using Microsoft.AspNetCore.Components.Forms

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudText>Избери Polyboard файл:</MudText>
        @* Drag-and-drop: with CustomContent, MudBlazor renders no drop overlay of its own, so we
           expose the internal <input> (Hidden="false") and stretch it transparently over the whole
           zone. A native file <input> accepts dropped files (assign + change) instead of letting the
           browser navigate to them. The wrapping .relative gives the absolute input its bounds. *@
        <div class="relative mud-width-full">
            <MudFileUpload T="IBrowserFile"
                           Accept=".txt,.csv"
                           MaximumFileCount="1"
                           FilesChanged="OnFileUpload"
                           Hidden="false"
                           InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                           InputStyle="opacity:0; cursor:pointer;"
                           Disabled="@(UserContextService.User.CreditsCount <= 0)">
                <CustomContent Context="fileUpload">
                    <MudPaper Outlined="true" Class="pa-8"
                              Style="border: 2px dashed var(--mud-palette-lines-inputs, #bdbdbd); text-align: center;">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body1">Плъзнете и пуснете Polyboard файл тук, или</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       OnClick="@(() => fileUpload.OpenFilePickerAsync())"
                                       Disabled="@(UserContextService.User.CreditsCount <= 0)">
                                Избери Polyboard файл
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </CustomContent>
            </MudFileUpload>
        </div>

        @if (_isLoadingFiles)
        {
            <Spinner />
        }
        @if (_isError)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
                Каченият файл не отговаря на изискванията за формат! Кредити не са консумирани. Моля, качете друг файл.
            </MudAlert>
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="my-2">
                Информация за формата може да намерите <a href="configuration">ТУК</a>
            </MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] ILogger<FileUploadComponent> Logger { get; set; }
    [Inject] IDetailsExtractorService DetailsExtractorService { get; set; }

    [Parameter] public ConverterContext Context { get; set; }
    [Parameter] public UserContextService UserContextService { get; set; }

    private bool _isLoadingFiles;
    private bool _isError;

    private async Task OnFileUpload(IBrowserFile file)
    {
        if (file is null || UserContextService.User.CreditsCount <= 0)
        {
            return;
        }

        _isError = false;
        _isLoadingFiles = true;
        try
        {
            var uploadFileStream = new MemoryStream();
            try
            {
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(uploadFileStream);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error while reading uploaded file");
                _isError = true;
                return;
            }

            var details = await DetailsExtractorService.ExtractDetails(uploadFileStream);
            if (!details.Any())
            {
                _isError = true;
                return;
            }

            Context.Details = new ObservableCollection<Detail>(details);
        }
        finally
        {
            // Always clear the spinner, even on the error/early-return paths (spinner-hang fix).
            _isLoadingFiles = false;
        }
    }
}
