<MudPaper Class="pa-4">
    <MudText Class="py-3">Избери една от опциите:</MudText>
    <MudStack Row="true" Class="py-3" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GridOn" OnClick="OnCreateFilesOptionSelected">Генерирай бланки за поръчка</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" OnClick="OnSendEmailOptionSelected">Изпрати Email поръчка</MudButton>
    </MudStack>
    @if (_shouldGenerateFiles)
    {
        @if (_areFilesGenerating)
        {
            <Spinner />
        }
        else
        {
            <ul class="p-4">
                @foreach (var file in _files)
                {
                    <li class="p-3"><a href="@file.Url" download="@file.Name" @onclick="OnFileLinkClicked">@file.Name</a></li>
                }
            </ul>
        }
    }
    @if (_shouldSendEmail)
    {
        if (string.IsNullOrEmpty(Context.ContactInfo.CompanyName) ||
            string.IsNullOrEmpty(Context.ContactInfo.MobileNumber))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
                <MudText Typo="Typo.subtitle2">Липсващи контакти</MudText>
                Няма въведен телефонен номер! Поръчката ще бъде изпратена без тази инфомация.
            </MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="my-2">
            <MudText Typo="Typo.subtitle2">Тестване</MudText>
            Използвайте отметката за да изпратите тестов Email само към вашата поща
            <MudCheckBox T="bool" @bind-Value="_isTestEmail" Label="Изпрати тестов Email" />
        </MudAlert>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-2">
            <MudText Typo="Typo.subtitle2">Информация</MudText>
            Тази опция ще изпрати реален Email към <span class="font-weight-bold">@(_isTestEmail ? Context.ContactInfo.Email : Context.TargetCompany.Email)</span> с прикачени и попълнени бланки
        </MudAlert>

        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OnSendEmailClicked">Изпрати e-mail поръчка</MudButton>

        if (_sendingEmail)
        {
            <Spinner />
        }
        else
        {
            @if (_isEmailSentSuccessful.HasValue && _isEmailSentSuccessful.Value)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="my-2">
                    <MudText Typo="Typo.subtitle2">Информация</MudText>
                    Успешно изпратихме е-mail към @_toEmail.Email
                </MudAlert>
            }
            @if (_isEmailSentSuccessful.HasValue && !_isEmailSentSuccessful.Value)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
                    <MudText Typo="Typo.subtitle2">Възникна грешка</MudText>
                    Моля опитайте пак или опишете проблема на email support@kroiko.com
                </MudAlert>
            }
        }
    }
</MudPaper>
