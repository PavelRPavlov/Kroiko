@using Kroiko.Domain

@if (!_isContactInfoComplete)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="my-2">
        Потребителският профил няма пълна информация
    </MudAlert>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="my-2">
        Генерираните документи няма да съдържат контакти
    </MudAlert>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-2">
        Може да въведете информацията в профилa си от <a href="MicrosoftIdentity/Account/EditProfile" class="btn btn-link">тук</a>
    </MudAlert>

    <MudPaper Class="pa-4 my-2">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Временни контакти (няма да бъдат запазени)</MudText>
        <MudForm>
            <MudTextField @bind-Value="ConverterContext.ContactInfo.CompanyName"
                          Label="Име на фирма"
                          Required="true"
                          RequiredError="Полето е задължително"
                          Class="my-2" />
            <MudTextField @bind-Value="ConverterContext.ContactInfo.MobileNumber"
                          Label="Телефон за връзка"
                          Required="true"
                          RequiredError="Полето е задължително"
                          Class="my-2" />
        </MudForm>
    </MudPaper>
    <br/>
}
