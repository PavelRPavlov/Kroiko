@using ATAFurniture.Server.Models
@using Kroiko.Domain.TemplateBuilding

<MudGrid Class="pa-3">
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Context.ContactInfo.CompanyName" Label="Име на клиента" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Context.ContactInfo.MobileNumber" Label="Телефон за връзка" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="File.FileName" Label="Материал" />
    </MudItem>
</MudGrid>

<MudDataGrid T="LoniraDetail" Items="@_source" ReadOnly="false"
             EditMode="DataGridEditMode.Cell" EditTrigger="DataGridEditTrigger.OnRowClick"
             Bordered="true" Dense="true" Class="pa-3">
    <Columns>
        <PropertyColumn Property="x => x.Height" Title="Размер по фладер [мм]" Editable="false" />
        <PropertyColumn Property="x => x.Width" Title="Размер срещу фладер [мм]" Editable="false" />
        <PropertyColumn Property="x => x.Quantity" Title="Брой детайли" Editable="false" />
        <PropertyColumn Property="x => x.LoniraEdges" Title="Кантиране" Editable="false" />
        <PropertyColumn Property="x => x.Note" Title="Забележка" Editable="true" Required="false" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="LoniraDetail" PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter] public KroikoFile File { get; set; }
    [Parameter] public ConverterContext Context { get; set; }

    private List<LoniraDetail> _source;

    protected override void OnInitialized()
    {
        _source = File.Details.Cast<LoniraDetail>().ToList();
    }
}
