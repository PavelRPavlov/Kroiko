@using ATAFurniture.Server.Models
@using Kroiko.Domain.CellsExtracting
@using Kroiko.Domain.TemplateBuilding
@using System.Collections.ObjectModel
@using Kroiko.Domain
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable

<MudPaper Class="pa-4">
    <MudText Class="py-3">Прегледай информацията и редактирай при необходимост:</MudText>
    @if (_isLoadingFiles)
    {
        <Spinner />
    }
    else
    {
        <MudTabs Rounded="true" Border="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            @foreach (var file in Context.Files)
            {
                <MudTabPanel Text="@file.FileName">
                    @switch (Context.TargetCompany.Name)
                    {
                        case nameof(SupportedCompanies.Lonira):
                            <LoniraTabItemContent File="@file" Context="@Context"/>
                            break;
                        case nameof(SupportedCompanies.MegaTrading):
                            <MegaTradingTabItemContent File="@file" Context="@Context"/>
                            break;
                        case nameof(SupportedCompanies.Suliver):
                            <SuliverTabItemContent File="@file" Context="@Context"/>
                            break;
                        default:
                            break;
                    }
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudPaper>

@code {
    [Inject] private IServiceProvider ServiceProvider { get; set; }
    [Parameter] public ConverterContext Context { get; set; }

    private bool _isLoadingFiles = true;
    private bool _isInternalChange = false;

    protected override void OnInitialized()
    {
        Context.PropertyChanged += ContextPropertyChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            LoadDataSource();

            // Brief delay so the loading indicator is visible before the tabs appear.
            await Task.Delay(TimeSpan.FromSeconds(1));
            _isLoadingFiles = false;
            StateHasChanged();
        }
    }

    private void ContextPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(ConverterContext.Details) ||
            e.PropertyName == nameof(ConverterContext.TargetCompany) &&
            !_isInternalChange)
        {
            _isLoadingFiles = true;
            LoadDataSource();
            _isLoadingFiles = false;
            StateHasChanged();
        }
    }

    private void LoadDataSource()
    {
        // A target company must be chosen before the details can be grouped into files.
        // For a first-time user (no previously-selected company) TargetCompany is null
        // until they pick one from the dropdown, so bail out instead of dereferencing it.
        // Selecting a company later re-invokes this via ContextPropertyChanged.
        if (Context.TargetCompany is null)
        {
            return;
        }

        // The order format maps and groups the details (ADR-0004 §1; Lonira: one file per material). A name
        // with no format (none today) gives no files, as the old switch's default did.
        var format = ServiceProvider.GetKeyedService<IOrderFormat>(Context.TargetCompany.Name);
        var result = format?.CreateFiles(Context.Details) ?? [];

        _isInternalChange = true;
        Context.Files = new ObservableCollection<KroikoFile>(result);
        _isInternalChange = false;
    }

    public void Dispose()
    {
        Context.PropertyChanged -= ContextPropertyChanged;
    }
}
